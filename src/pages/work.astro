---
import Layout from '../layouts/Layout.astro';
import CallToAction from '../components/CallToAction.astro';

const caseStudies = [
  {
    slug: 'fernhill',
    title: 'FERNHILL',
    industry: 'FREIGHT SOFTWARE',
    year: '2025',
    metricValue: '+41%',
    metricLabel: 'QUALIFIED PIPELINE',
    headline: 'Repositioning a freight platform from “cheapest” to “most certain”.',
    coverImage: '/images/3VQynPXYJkfR1omKmA1DVIAlKQI.jpg'
  },
  {
    slug: 'oakmont-health',
    title: 'OAKMONT HEALTH',
    industry: 'CLINIC SOFTWARE',
    year: '2025',
    metricValue: '2.3×',
    metricLabel: 'ENTERPRISE WIN RATE',
    headline: 'Turning a founder-led sales team into a repeatable one.',
    coverImage: '/images/dlrUWNpE3qg6yY2mt4QEw7q9pHM.jpg'
  },
  {
    slug: 'tidewater',
    title: 'TIDEWATER STUDIO',
    industry: 'ARCHITECTURE',
    year: '2024',
    metricValue: '+33%',
    metricLabel: 'AVERAGE PROJECT FEE',
    headline: 'Raising fees by a third without losing a single client.',
    coverImage: '/images/7i4qol44iSB6jMEujzXAV7BIrk8.jpg'
  }
];
---

<Layout title="Work — Margin">
  <div class="site-container" style="padding-top: 140px; padding-bottom: 60px;">
    <div style="font-family: var(--font-mono); font-size: 13px; color: var(--text-subtle); text-transform: uppercase; margin-bottom: 16px;">
      HOME / WORK
    </div>
    <h1 class="hero-headline" style="max-width: 800px;">
      Results we can show our working for.
    </h1>
    <p class="hero-subhead" style="max-width: 600px;">
      Three engagements, written with the clients.
    </p>

    <div style="display: flex; flex-direction: column; gap: 40px; margin-top: 56px;">
      {caseStudies.map((cs) => (
        <a href={`/work/${cs.slug}`} style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 40px; background-color: var(--bg-card); border-radius: 24px; padding: 40px; border: 1px solid var(--border-card); align-items: center; transition: transform 0.35s var(--ease-framer), box-shadow 0.35s var(--ease-framer);">
          <div style="height: 320px; border-radius: 16px; overflow: hidden;">
            <img src={cs.coverImage} alt={cs.title} style="width: 100%; height: 100%; object-fit: cover;" loading="lazy" />
          </div>

          <div>
            <div style="font-family: var(--font-serif); font-size: clamp(48px, 6vw, 80px); color: var(--accent); line-height: 1; margin-bottom: 8px;">
              {cs.metricValue}
            </div>
            <div style="font-family: var(--font-mono); font-size: 13px; text-transform: uppercase; color: var(--text-muted); margin-bottom: 16px;">
              {cs.metricLabel}
            </div>

            <div style="font-family: var(--font-mono); font-size: 12px; color: var(--text-subtle); text-transform: uppercase; margin-bottom: 12px;">
              {cs.title} · {cs.industry} · {cs.year}
            </div>

            <h2 style="font-family: var(--font-serif); font-size: 26px; line-height: 1.3; margin-bottom: 20px;">
              {cs.headline}
            </h2>

            <span style="font-weight: 600; color: var(--accent); font-size: 15px;">
              Read the case →
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
  <CallToAction />
</Layout>
