---
import Layout from '../layouts/Layout.astro';
import CallToAction from '../components/CallToAction.astro';

const services = [
  {
    numberCode: '01',
    title: 'Positioning',
    price: '$24,000',
    slug: 'positioning',
    type: 'FIXED-SCOPE PROJECT',
    duration: '6 WEEKS',
    desc: 'Decide who you are for, who you are not for, and how to say it so the right buyers recognise themselves in the first sentence.'
  },
  {
    numberCode: '02',
    title: 'Go-to-market',
    price: '$38,000',
    slug: 'go-to-market',
    type: 'FIXED-SCOPE PROJECT',
    duration: '8–10 WEEKS',
    desc: 'Choose the segments, channels and sales motions worth funding next year, and agree which ones to stop funding now.'
  },
  {
    numberCode: '03',
    title: 'Advisory',
    price: '$8,000 / mo',
    slug: 'advisory',
    type: 'MONTHLY RETAINER',
    duration: '6 MONTHS MINIMUM',
    desc: 'A partner in your leadership meetings two days a month, for the decisions you would rather not make alone.'
  }
];

const comparisons = [
  {
    quote: '“Buyers don’t get what we do until the third call.”',
    usualFix: 'Rebrand.',
    solution: 'Positioning',
    slug: 'positioning'
  },
  {
    quote: '“We have more growth ideas than people to run them.”',
    usualFix: 'Hire faster.',
    solution: 'Go-to-market',
    slug: 'go-to-market'
  },
  {
    quote: '“I’m making big calls with nobody to test them against.”',
    usualFix: 'Add another layer of management.',
    solution: 'Advisory',
    slug: 'advisory'
  }
];

const phases = [
  { code: '01', title: 'Diagnose', timing: 'WEEKS 1–2', desc: 'Interviews with your team, customers and lost deals, then the numbers you already have.' },
  { code: '02', title: 'Decide', timing: 'WEEKS 3–4', desc: 'One session with your leadership team to choose the two or three moves that matter.' },
  { code: '03', title: 'Build', timing: 'WEEKS 5–10', desc: 'We work alongside your people to put the decisions into practice.' },
  { code: '04', title: 'Hand over', timing: 'WEEKS 11–12', desc: 'Owners named, rhythms running, and a check-in already in the diary.' }
];
---

<Layout title="Services — Margin">
  <div class="site-container" style="padding-top: 140px; padding-bottom: 60px;">
    <div style="font-family: var(--font-mono); font-size: 13px; color: var(--text-subtle); text-transform: uppercase; margin-bottom: 16px;">
      HOME / SERVICES
    </div>
    <h1 class="hero-headline" style="max-width: 800px;">
      Three ways to work with us.
    </h1>
    <p class="hero-subhead" style="max-width: 650px;">
      Each one is scoped around a decision, and priced up front.
    </p>

    <!-- Pricing Cards Grid -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 28px; margin-top: 56px;">
      {services.map((srv) => (
        <div style="background-color: var(--bg-card); border-radius: 20px; padding: 36px 32px; border: 1px solid var(--border-card); display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 24px;">
              <span style="font-family: var(--font-mono); font-size: 14px; color: var(--text-subtle);">{srv.numberCode}</span>
              <span style="font-family: var(--font-serif); font-size: 28px; color: var(--accent);">{srv.price}</span>
            </div>

            <h2 style="font-family: var(--font-serif); font-size: 28px; margin-bottom: 16px;">{srv.title}</h2>
            <p style="font-size: 15px; line-height: 1.6; color: var(--text-muted); margin-bottom: 28px;">
              {srv.desc}
            </p>
          </div>

          <div>
            <div style="font-family: var(--font-mono); font-size: 12px; color: var(--text-subtle); text-transform: uppercase; margin-bottom: 16px;">
              {srv.type} · {srv.duration}
            </div>
            <a href={`/services/${srv.slug}`} class="nav-cta" style="display: block; text-align: center; padding: 12px 20px;">
              See what’s included →
            </a>
          </div>
        </div>
      ))}
    </div>

    <p style="font-family: var(--font-mono); font-size: 13px; color: var(--text-subtle); margin-top: 24px;">
      Half at kick-off, half at hand-over. Advisory is billed monthly. No hourly rates.
    </p>

    <!-- Diagnostic Comparison Matrix -->
    <div style="margin-top: 100px; padding-top: 60px; border-top: 1px solid var(--border-light);">
      <h2 class="section-heading">Not sure which? Start with what you’d say.</h2>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px; margin-top: 36px;">
        {comparisons.map((c) => (
          <div style="background-color: var(--bg-card); border-radius: 18px; padding: 28px; border: 1px solid var(--border-card);">
            <p style="font-family: var(--font-serif); font-size: 20px; line-height: 1.4; margin-bottom: 24px;">
              {c.quote}
            </p>
            <div style="margin-bottom: 16px;">
              <div style="font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; color: var(--text-subtle);">USUAL FIX</div>
              <div style="font-size: 15px; color: var(--text-muted); margin-top: 4px;">{c.usualFix}</div>
            </div>
            <div>
              <div style="font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; color: var(--text-subtle);">START WITH</div>
              <a href={`/services/${c.slug}`} style="font-weight: 600; color: var(--accent); font-size: 15px; margin-top: 4px; display: inline-block;">{c.solution} →</a>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Process Phases Timeline -->
    <div style="margin-top: 100px; padding-top: 60px; border-top: 1px solid var(--border-light);">
      <div class="section-label">A TYPICAL PROJECT</div>
      <h2 class="section-heading">Twelve weeks, four phases.</h2>
      <p style="font-size: 17px; color: var(--text-muted); margin-bottom: 40px; max-width: 600px;">
        The weeks flex to fit the problem. The order doesn’t.
      </p>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px;">
        {phases.map((ph) => (
          <div style="background-color: var(--bg-card); border-radius: 16px; padding: 24px; border: 1px solid var(--border-card);">
            <div style="font-family: var(--font-mono); font-size: 12px; color: var(--accent); margin-bottom: 8px;">{ph.timing}</div>
            <h3 style="font-family: var(--font-serif); font-size: 22px; margin-bottom: 10px;">{ph.code} {ph.title}</h3>
            <p style="font-size: 14px; line-height: 1.5; color: var(--text-muted);">{ph.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
  <CallToAction />
</Layout>
