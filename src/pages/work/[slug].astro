---
import Layout from '../../layouts/Layout.astro';
import CallToAction from '../../components/CallToAction.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import { siteData } from '../../data/siteData';

export function getStaticPaths() {
  return siteData.caseStudies.map((caseStudy) => ({
    params: { slug: caseStudy.slug },
    props: { caseStudy }
  }));
}

const { caseStudy } = Astro.props;
---

<Layout title={`${caseStudy.title}: ${caseStudy.headline} — Margin`}>
  <div class="site-container" style="padding-top: 140px; padding-bottom: 60px;">
    <div style="font-family: var(--font-mono); font-size: 13px; color: var(--text-subtle); text-transform: uppercase; margin-bottom: 16px;">
      HOME / WORK / {caseStudy.title.toUpperCase()}
    </div>

    <div style="font-family: var(--font-mono); font-size: 13px; color: var(--text-subtle); text-transform: uppercase; margin-bottom: 12px;">
      {caseStudy.industry} · {caseStudy.year}
    </div>

    <h1 class="hero-headline" style="max-width: 900px; margin-bottom: 24px;">
      {caseStudy.headline}
    </h1>

    <div style="display: flex; gap: 32px; align-items: baseline; margin-bottom: 48px;">
      <div style="font-family: var(--font-serif); font-size: clamp(56px, 7vw, 96px); color: var(--accent); line-height: 1;">
        {caseStudy.metricValue}
      </div>
      <div style="font-family: var(--font-mono); font-size: 16px; text-transform: uppercase; color: var(--text-muted);">
        {caseStudy.metricLabel}
      </div>
    </div>

    <div style="height: 440px; border-radius: 24px; overflow: hidden; margin-bottom: 64px;">
      <ResponsiveImage 
        src={caseStudy.coverImage} 
        alt={caseStudy.title} 
        width={1344}
        height={440}
        widths={[390, 768, 1024, 1344, 2048]}
        sizes="(max-width: 1344px) 100vw, 1344px"
        priority={true}
        style="width: 100%; height: 100%; object-fit: cover;" 
      />
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 48px; margin-bottom: 80px;">
      <div style="background-color: var(--bg-card); border-radius: 24px; padding: 40px; border: 1px solid var(--border-card);">
        <h2 style="font-family: var(--font-serif); font-size: 26px; margin-bottom: 16px;">The Challenge</h2>
        <p style="font-size: 16px; line-height: 1.65; color: var(--text-muted); margin-bottom: 28px;">
          {caseStudy.summary}
        </p>

        <h2 style="font-family: var(--font-serif); font-size: 26px; margin-bottom: 16px;">The Hard Decisions Made</h2>
        <ul style="list-style: none; display: flex; flex-direction: column; gap: 14px; font-size: 15px; color: var(--text-main);">
          <li style="display: flex; gap: 10px;">
            <span style="color: var(--accent); font-weight: 700;">✓</span>
            <span>Stopped bidding on low-margin general tenders.</span>
          </li>
          <li style="display: flex; gap: 10px;">
            <span style="color: var(--accent); font-weight: 700;">✓</span>
            <span>Refactored pricing into value retainers rather than hourly cost.</span>
          </li>
          <li style="display: flex; gap: 10px;">
            <span style="color: var(--accent); font-weight: 700;">✓</span>
            <span>Altered discovery criteria to decline out-of-scope prospect requests.</span>
          </li>
        </ul>
      </div>

      <div style="background-color: var(--bg-card); border-radius: 24px; padding: 40px; border: 1px solid var(--border-card); display: flex; flex-direction: column; justify-content: space-between;">
        <div>
          <div class="section-label">Executive Outcome</div>
          <h2 style="font-family: var(--font-serif); font-size: 26px; margin-bottom: 16px;">Sustained focus over volume</h2>
          <p style="font-size: 16px; line-height: 1.65; color: var(--text-muted);">
            Within two quarters of stopping non-core sales activities, qualification conversion doubled and average contract values escalated across every subsequent cohort.
          </p>
        </div>

        <div style="margin-top: 36px;">
          <a href="/contact" class="primary-btn" style="width: 100%; text-align: center;">
            Discuss your strategy with a partner →
          </a>
        </div>
      </div>
    </div>
  </div>
  <CallToAction />
</Layout>
