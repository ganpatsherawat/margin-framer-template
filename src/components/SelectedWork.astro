---
import { siteData } from '../data/siteData';
import ResponsiveImage from './ResponsiveImage.astro';
---

<section class="selected-work-section" id="work">
  <div class="site-container">
    <div class="section-top-bar">
      <h2 class="section-heading" style="margin-bottom: 0;">Selected work</h2>
      <a href="/work" class="section-link-all">
        <span>All case studies</span>
        <span>→</span>
      </a>
    </div>

    <div class="work-rows-list">
      {siteData.caseStudies.map((study) => (
        <a href={`/work/${study.slug}`} class="work-row-item">
          <div class="work-row-left">
            <h3 class="work-row-title">{study.title}</h3>
            <span class="work-row-industry">{study.industry}</span>
            <div class="work-row-thumb">
              <ResponsiveImage 
                src={study.coverImage} 
                alt={study.title} 
                width={78} 
                height={52} 
                widths={[78, 156]} 
                sizes="78px" 
              />
            </div>
          </div>

          <div class="work-row-right">
            <div class="work-row-metrics">
              <span class="work-row-metric-val">{study.metricValue}</span>
              <span class="work-row-metric-label">{study.metricLabel}</span>
            </div>
            <div class="work-row-arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
