---
import { siteData } from '../data/siteData';
---

<section style="padding: 80px 0;" id="work">
  <div class="site-container">
    <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 32px;">
      <div>
        <div class="section-label">Case Studies</div>
        <h2 class="section-heading" style="margin-bottom: 0;">Selected work</h2>
      </div>

      <a href="/work" class="nav-item" style="display: inline-flex; align-items: center; gap: 6px; font-weight: 600;">
        <span>All case studies</span>
        <span>→</span>
      </a>
    </div>

    <div class="work-grid">
      {siteData.caseStudies.map((study) => (
        <a href={`/work/${study.slug}`} class="work-card">
          <div class="work-card-image">
            <img src={study.coverImage} alt={study.title} loading="lazy" />
          </div>

          <div class="work-card-body">
            <div class="work-card-header">
              <h3 class="work-card-title">{study.title}</h3>
              <span class="work-card-industry">{study.industry}</span>
            </div>

            <div style="margin-top: auto; padding-top: 24px;">
              <div class="work-metric-val">{study.metricValue}</div>
              <div class="work-metric-label">{study.metricLabel}</div>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
