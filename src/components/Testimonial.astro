---
import { siteData } from '../data/siteData';

const { testimonial } = siteData;
---

<section class="testimonial-section">
  <div class="site-container">
    <div class="testimonial-card">
      <div class="testimonial-image-col">
        <img src={testimonial.image} alt={testimonial.company} loading="lazy" />
      </div>

      <div>
        <blockquote class="testimonial-quote">
          {testimonial.quote}
        </blockquote>

        <div class="testimonial-author-meta">
          <div class="author-avatar-badge" aria-hidden="true">
            {testimonial.initials}
          </div>

          <div>
            <div class="author-name">{testimonial.author}</div>
            <div class="author-role">{testimonial.role}, {testimonial.company}</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
