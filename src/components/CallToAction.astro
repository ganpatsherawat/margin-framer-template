---
import { siteData } from '../data/siteData';

const { ctaBanner } = siteData;
---

<section class="pre-footer-cta-section">
  <div class="site-container">
    <div class="cta-inner-block">
      <div class="cta-availability">
        <span class="cta-dot"></span>
        <span class="cta-tagline">{ctaBanner.badge}</span>
      </div>

      <h2 class="cta-title">{ctaBanner.headline}</h2>

      <div class="cta-row">
        <p class="cta-desc">{ctaBanner.subhead}</p>

        <a href="/contact" class="primary-btn">
          <span>{ctaBanner.ctaButton}</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
